<Page x:Class="FeralCode.MultiviewSetupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Multiview Setup" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextPrimary}"
      PreviewKeyDown="Page_PreviewKeyDown" KeepAlive="True">
	  
    <Page.Resources>
        <Style TargetType="Button" x:Key="ChannelListItemStyle">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,10,8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BgBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BgBorder" Property="BorderBrush" Value="{DynamicResource StatusConnecting}"/>
                                <Setter TargetName="BgBorder" Property="Background" Value="{DynamicResource CardHoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BgBorder" Property="BorderBrush" Value="{DynamicResource LiveBorder}"/>
                                <Setter TargetName="BgBorder" Property="Background" Value="{DynamicResource CardHoverBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
		<Style x:Key="ActionBtnStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" BorderThickness="3" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#FFD700"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
		<Style x:Key="GlowFocusStyle" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderThickness="3" BorderBrush="#FFD700" CornerRadius="4" Margin="-3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,20">
            <Button Content="🏠 Home" Margin="0,0,20,0" Click="HomeButton_Click" FontSize="16" Padding="15,8" Background="{DynamicResource LiveBorder}" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <TextBlock Text="🔳 MULTIVIEW SETUP" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource PanelBackground}" CornerRadius="8" Padding="15" Margin="0,0,20,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/> <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="1. Select Live Channels" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>
                    
                    <Grid Grid.Row="1" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="CollectionComboBox" 
          Grid.Column="0" Width="200" FontSize="18" Margin="0,0,10,0" 
          VerticalContentAlignment="Center"
          SelectionChanged="CollectionComboBox_SelectionChanged" 
          FocusVisualStyle="{StaticResource GlowFocusStyle}">
    <ComboBox.ItemContainerStyle>
        <Style TargetType="ComboBoxItem">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
    </ComboBox.ItemContainerStyle>
</ComboBox>
                        <TextBox x:Name="SearchTextBox" Grid.Column="1" FontSize="16" Padding="8" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" TextChanged="SearchTextBox_TextChanged" FocusVisualStyle="{StaticResource GlowFocusStyle}"/>
                    </Grid>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ChannelsListControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ChannelListItemStyle}" Click="Channel_Click" Tag="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <Border Grid.Column="0" Background="#474747" CornerRadius="8" Margin="0,0,15,0" Width="100" Height="75" ClipToBounds="True" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                                                <Grid>
                                                    <TextBlock Text="{Binding Number}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="24" FontWeight="Bold" Foreground="#444444">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ImageUrl}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding ImageUrl}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    
                                                    <Image Source="{Binding ImageUrl}" Stretch="Uniform" Margin="5"/>
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <Border Background="{DynamicResource LiveBorder}" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding Number}" FontWeight="Bold" FontSize="13" Foreground="White"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                                                </StackPanel>
                                                
                                                <TextBlock Text="{Binding CurrentShowTitle}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                                                
                                                <TextBlock Text="{Binding CurrentAirings[0].EpisodeTitle}" FontSize="14" FontStyle="Italic" Foreground="{DynamicResource LiveBorder}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Text="{Binding CurrentAirings[0].DisplaySummary}" FontSize="13" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" MaxHeight="38" TextWrapping="Wrap" LineHeight="18"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource PanelBackground}" CornerRadius="8" Padding="15">
                <StackPanel>
                    <TextBlock Text="2. Selected Screens" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>
                    
                    <Border Background="{DynamicResource AppBackground}" CornerRadius="6" Padding="15" Margin="0,0,0,10">
                        <Grid>
                            <TextBlock x:Name="Slot1Text" Text="Slot 1: Empty" FontSize="16" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            <Button x:Name="RemoveSlot1" Content="❌" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource StatusError}" FontSize="14" Cursor="Hand" Visibility="Collapsed" Click="RemoveSlot_Click" Tag="0" ToolTip="Remove from Slot 1"/>
                        </Grid>
                    </Border>
                    
                    <Border Background="{DynamicResource AppBackground}" CornerRadius="6" Padding="15" Margin="0,0,0,10">
                        <Grid>
                            <TextBlock x:Name="Slot2Text" Text="Slot 2: Empty" FontSize="16" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            <Button x:Name="RemoveSlot2" Content="❌" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource StatusError}" FontSize="14" Cursor="Hand" Visibility="Collapsed" Click="RemoveSlot_Click" Tag="1" ToolTip="Remove from Slot 2"/>
                        </Grid>
                    </Border>
                    
                    <Border Background="{DynamicResource AppBackground}" CornerRadius="6" Padding="15" Margin="0,0,0,10">
                        <Grid>
                            <TextBlock x:Name="Slot3Text" Text="Slot 3: Empty" FontSize="16" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            <Button x:Name="RemoveSlot3" Content="❌" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource StatusError}" FontSize="14" Cursor="Hand" Visibility="Collapsed" Click="RemoveSlot_Click" Tag="2" ToolTip="Remove from Slot 3"/>
                        </Grid>
                    </Border>
                    
                    <Border Background="{DynamicResource AppBackground}" CornerRadius="6" Padding="15" Margin="0,0,0,30">
                        <Grid>
                            <TextBlock x:Name="Slot4Text" Text="Slot 4: Empty" FontSize="16" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                            <Button x:Name="RemoveSlot4" Content="❌" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource StatusError}" FontSize="14" Cursor="Hand" Visibility="Collapsed" Click="RemoveSlot_Click" Tag="3" ToolTip="Remove from Slot 4"/>
                        </Grid>
                    </Border>

                    <Button x:Name="LaunchButton" Content="▶ LAUNCH MULTIVIEW" FontSize="20" FontWeight="Bold" Padding="20" Background="{DynamicResource StatusSuccess}" Foreground="Black" Cursor="Hand" Click="Launch_Click" IsEnabled="False" Style="{StaticResource ActionBtnStyle}"/>
                    <Button x:Name="ClearButton" Content="Clear All" FontSize="16" Margin="0,15,0,0" Padding="10" Background="Transparent" Foreground="{DynamicResource StatusError}" Cursor="Hand" Click="Clear_Click" Style="{StaticResource ActionBtnStyle}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>